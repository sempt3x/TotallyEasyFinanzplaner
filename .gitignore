# =====================================================================
#  Totally Easy Finanzplaner – .gitignore
# =====================================================================

# ---------------------------------------------------------------------
#  Persönliche Finanzdaten – NIEMALS einchecken
# ---------------------------------------------------------------------
# Finanzpläne (auch verschlüsselte) und Programmeinstellungen
*.finanzplan
daten.json
einstellungen.json

# Automatische Sicherungskopien (vor Formatumstellung / defekte Dateien)
*.vor-v*
*.defekt-*

# Halb geschriebene Dateien beim Speichern
*.tmp

# CSV-Exporte und Tabellen mit echten Zahlen
*.csv
*.xlsx
*.xls
*.xlsm
*.xlsb
~$*

# ---------------------------------------------------------------------
#  Zugangsdaten, Schlüssel und Zertifikate
# ---------------------------------------------------------------------
# Code-Signing-Zertifikate und Strong-Name-Schlüssel
*.pfx
*.p12
*.snk
*.cer
*.crt
*.pem
*.key
# Umgebungsvariablen / lokale Geheimnisse
.env
.env.*
!.env.example
secrets.json
*.secrets.json
appsettings.*.local.json
# Publish-Profile (können Server-Zugangsdaten enthalten)
*.pubxml
*.pubxml.user
*.publishsettings
PublishProfiles/
# Cloud-/Tool-Zugangsdaten
.aws/
.azure/
credentials
*.credentials

# ---------------------------------------------------------------------
#  KI-Assistenten (lokale Einstellungen und Verläufe)
# ---------------------------------------------------------------------
.claude/settings.local.json
.claude/*.local.*
.cursor/
.aider*
.continue/

# ---------------------------------------------------------------------
#  Logs, Abstürze, temporäre und Sicherungsdateien
# ---------------------------------------------------------------------
*.log
*.dmp
*.mdmp
*.stackdump
*.bak
*.orig
*.rej
*.swp
*~
*.cache
_ReSharper*/
*.[Rr]e[Ss]harper
.fake/
.ionide/

# ---------------------------------------------------------------------
#  Build-Ausgaben
# ---------------------------------------------------------------------
[Bb]in/
[Oo]bj/
[Pp]ublish/
[Aa]rtifacts/
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Ll]og/
[Ll]ogs/
*.binlog

# NuGet
*.nupkg
*.snupkg
**/packages/*
!**/packages/build/
project.assets.json
project.nuget.cache

# Tests / Coverage
[Tt]est[Rr]esult*/
*.trx
coverage*.json
coverage*.xml
*.coverage
*.coveragexml

# ---------------------------------------------------------------------
#  IDEs und Editoren
# ---------------------------------------------------------------------
# Visual Studio
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.rsuser

# JetBrains Rider
.idea/
*.sln.iml
*.DotSettings.user

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ---------------------------------------------------------------------
#  Betriebssystem
# ---------------------------------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
