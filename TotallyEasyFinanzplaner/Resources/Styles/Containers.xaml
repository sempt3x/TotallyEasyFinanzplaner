<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Flächen, Rahmen und Hinweisboxen -->

    <!-- ================================================================ Karten -->
    <!-- Karte: helle Fläche mit feinem Rahmen -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
    </Style>

    <!-- Kopfzeile einer Karte mit Trennlinie darunter (Gehälter, Einnahmen, Ausgaben) -->
    <Style x:Key="CardHeader" TargetType="Border">
        <Setter Property="DockPanel.Dock" Value="Top"/>
        <Setter Property="Padding" Value="18,12"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>

    <!-- Nur Rahmen, ohne eigene Fläche (Gruppen in Dialogen) -->
    <Style x:Key="OutlineBox" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
    </Style>

    <!-- ================================================================ Symbol-Kacheln -->
    <!-- Quadratische Kachel hinter einem Symbol; Hintergrund setzt der Aufrufer (…SoftBrush) -->
    <Style x:Key="IconTile" TargetType="Border">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="CornerRadius" Value="4"/>
    </Style>

    <!-- Symbol in einer Kachel; Farbe setzt der Aufrufer -->
    <Style x:Key="IconTileGlyph" TargetType="TextBlock" BasedOn="{StaticResource Icon}">
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <!-- ================================================================ Hinweise -->
    <!-- Blaue Hinweisbox: InfoGlyph + InfoText in einem DockPanel -->
    <Style x:Key="InfoBox" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
        <Setter Property="CornerRadius" Value="5"/>
        <Setter Property="Padding" Value="12,10"/>
    </Style>

    <Style x:Key="InfoGlyph" TargetType="TextBlock" BasedOn="{StaticResource Icon}">
        <Setter Property="DockPanel.Dock" Value="Left"/>
        <Setter Property="Text" Value="&#xE946;"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Margin" Value="0,2,10,0"/>
    </Style>

    <Style x:Key="InfoText" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="LineHeight" Value="18"/>
    </Style>

    <!-- Orangefarbene Warnzeile (z. B. Feststelltaste): WarningGlyph + WarningText -->
    <Style x:Key="WarningGlyph" TargetType="TextBlock" BasedOn="{StaticResource Icon}">
        <Setter Property="Text" Value="&#xE7BA;"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource OneTimeBrush}"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
    </Style>

    <Style x:Key="WarningText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Foreground" Value="{DynamicResource OneTimeBrush}"/>
    </Style>

    <!-- ================================================================ Trenner -->
    <!-- Senkrechter Strich zwischen Button-Gruppen -->
    <Style x:Key="ToolbarSeparator" TargetType="Rectangle">
        <Setter Property="Width" Value="1"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="Fill" Value="{DynamicResource LineBrush}"/>
        <Setter Property="Margin" Value="2,0,12,0"/>
    </Style>
</ResourceDictionary>
