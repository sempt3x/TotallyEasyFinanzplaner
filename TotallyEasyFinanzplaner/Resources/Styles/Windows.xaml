<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Fenster und Dialoge.

        Aufbau aller Dialoge:
          <Window Style="{StaticResource DialogWindow}">
            <DockPanel>
              <Border Style="{StaticResource DialogFooter}"> … Buttons … </Border>
              <StackPanel Style="{StaticResource DialogContent}">
                <DockPanel Style="{StaticResource DialogHeader}">
                  <Border Style="{StaticResource DialogBadge}"><TextBlock Style="{StaticResource DialogBadgeGlyph}" Text="…"/></Border>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource DialogTitle}"/>
                    <TextBlock Style="{StaticResource DialogSubtitle}"/>
                  </StackPanel>
                </DockPanel>
                … Inhalt …
              </StackPanel>
            </DockPanel>
          </Window>
    -->

    <!-- ================================================================ Fenster -->
    <!-- Gemeinsame Grundeinstellungen aller Fenster -->
    <Style x:Key="AppWindow" TargetType="Window">
        <Setter Property="Icon" Value="pack://application:,,,/TotallyEasyFinanzplaner;component/Assets/app.ico"/>
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
    </Style>

    <!-- Dialog: ohne Taskleisteneintrag, Höhe passt sich dem Inhalt an.
         WindowStartupLocation="CenterOwner" muss direkt am Fenster stehen (keine Dependency Property). -->
    <Style x:Key="DialogWindow" TargetType="Window" BasedOn="{StaticResource AppWindow}">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="ShowInTaskbar" Value="False"/>
        <Setter Property="ResizeMode" Value="NoResize"/>
        <Setter Property="SizeToContent" Value="Height"/>
    </Style>

    <!-- ================================================================ Dialog-Bereiche -->
    <!-- Inhaltsbereich -->
    <Style x:Key="DialogContent" TargetType="FrameworkElement">
        <Setter Property="Margin" Value="24,22,24,18"/>
    </Style>

    <!-- Fußleiste mit den Buttons; muss das erste Kind des äußeren DockPanels sein -->
    <Style x:Key="DialogFooter" TargetType="Border">
        <Setter Property="DockPanel.Dock" Value="Bottom"/>
        <Setter Property="Background" Value="{DynamicResource CanvasBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
        <Setter Property="Padding" Value="20,12"/>
    </Style>

    <!-- Rechtsbündige Button-Reihe in der Fußleiste -->
    <Style x:Key="DialogButtons" TargetType="StackPanel">
        <Setter Property="DockPanel.Dock" Value="Right"/>
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
    </Style>

    <Style x:Key="DialogButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="MinWidth" Value="100"/>
    </Style>

    <!-- Hauptaktion; steht ganz rechts, daher ohne Außenabstand -->
    <Style x:Key="DialogPrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="MinWidth" Value="110"/>
        <Setter Property="Margin" Value="0"/>
    </Style>

    <!-- ================================================================ Dialog-Kopf -->
    <Style x:Key="DialogHeader" TargetType="DockPanel">
        <Setter Property="DockPanel.Dock" Value="Top"/>
        <Setter Property="Margin" Value="0,0,0,16"/>
    </Style>

    <!-- Runder Symbolkreis links neben der Überschrift -->
    <Style x:Key="DialogBadge" TargetType="Border">
        <Setter Property="DockPanel.Dock" Value="Left"/>
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="CornerRadius" Value="20"/>
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Margin" Value="0,0,14,0"/>
    </Style>

    <Style x:Key="DialogBadgeGlyph" TargetType="TextBlock" BasedOn="{StaticResource Icon}">
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="DialogTitle" TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}">
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="DialogSubtitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,3,0,0"/>
    </Style>
</ResourceDictionary>
