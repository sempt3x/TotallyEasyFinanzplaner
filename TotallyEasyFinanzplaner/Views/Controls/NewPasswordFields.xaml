<!--
    Neues Passwort + Wiederholung mit Stärkeanzeige.
    Wird in PasswordDialog (Festlegen / Ändern) und NewPlanDialog verwendet.
-->
<UserControl x:Class="TotallyEasyFinanzplaner.NewPasswordFields"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <!-- ============================================================ Neues Passwort -->
        <TextBlock x:Name="NewLabel" Style="{StaticResource FieldLabel}" Text="Neues Passwort"/>
        <PasswordBox x:Name="NewBox" PasswordChanged="Password_Changed" KeyUp="Box_KeyUp" GotFocus="Box_KeyUp"/>

        <!-- Stärke: vier Segmente, der Code färbt sie ein -->
        <DockPanel Margin="0,8,0,0">
            <TextBlock x:Name="StrengthText" Style="{StaticResource HintText}" DockPanel.Dock="Right"
                       Width="80" TextAlignment="Right" Text="–"/>
            <UniformGrid x:Name="StrengthBar" Rows="1" Columns="4" Height="4" VerticalAlignment="Center">
                <UniformGrid.Resources>
                    <Style TargetType="Border">
                        <Setter Property="Margin" Value="0,0,3,0"/>
                        <Setter Property="CornerRadius" Value="2"/>
                        <Setter Property="Background" Value="{DynamicResource LineBrush}"/>
                    </Style>
                </UniformGrid.Resources>
                <Border/>
                <Border/>
                <Border/>
                <Border Margin="0"/>
            </UniformGrid>
        </DockPanel>
        <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,0"
                   Text="Mindestens 8 Zeichen. Länger ist besser – z. B. ein Satz aus mehreren Wörtern."/>

        <!-- ============================================================ Wiederholung -->
        <TextBlock Style="{StaticResource FieldLabel}" Text="Passwort wiederholen" Margin="0,14,0,6"/>
        <PasswordBox x:Name="ConfirmBox" PasswordChanged="Password_Changed" KeyUp="Box_KeyUp" GotFocus="Box_KeyUp"/>
        <TextBlock x:Name="MatchText" FontSize="11.5" Margin="0,5,0,0" Visibility="Collapsed"/>

        <StackPanel x:Name="CapsWarning" Orientation="Horizontal" Margin="0,8,0,0" Visibility="Collapsed">
            <TextBlock Style="{StaticResource WarningGlyph}"/>
            <TextBlock Style="{StaticResource WarningText}" Text="Die Feststelltaste ist aktiv."/>
        </StackPanel>
    </StackPanel>
</UserControl>
