<!--
    Kreditplan bzw. Ratenzahlung anlegen oder bearbeiten.
    Rate und Anzahl der Raten hängen zusammen: Wer die Anzahl einträgt, bekommt die passende Rate berechnet (LoanDialog.xaml.cs).
-->
<Window x:Class="TotallyEasyFinanzplaner.LoanDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TotallyEasyFinanzplaner"
        xmlns:m="clr-namespace:TotallyEasyFinanzplaner.Models"
        Style="{StaticResource DialogWindow}" WindowStartupLocation="CenterOwner" Title="Kreditplan" Width="540">
    <DockPanel>
        <!-- ============================================================ Fußleiste -->
        <Border Style="{StaticResource DialogFooter}">
            <StackPanel Style="{StaticResource DialogButtons}">
                <Button Style="{StaticResource DialogButton}" Content="Abbrechen" IsCancel="True"/>
                <Button Style="{StaticResource DialogPrimaryButton}" Content="Speichern" IsDefault="True" Click="Ok_Click"/>
            </StackPanel>
        </Border>

        <StackPanel Style="{StaticResource DialogContent}">
            <!-- ======================================================== Kopf -->
            <DockPanel Style="{StaticResource DialogHeader}" Margin="0,0,0,18">
                <Border Style="{StaticResource DialogBadge}">
                    <TextBlock x:Name="HeaderGlyph" Style="{StaticResource DialogBadgeGlyph}" Text="&#xE825;"/>
                </Border>
                <TextBlock x:Name="HeaderText" Style="{StaticResource DialogTitle}" VerticalAlignment="Center"/>
            </DockPanel>

            <!-- ======================================================== Formular -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- 0  Art -->
                    <RowDefinition Height="Auto"/> <!-- 1  Bezeichnung -->
                    <RowDefinition Height="Auto"/> <!-- 2  Bank / Händler -->
                    <RowDefinition Height="Auto"/> <!-- 3  Betrag -->
                    <RowDefinition Height="Auto"/> <!-- 4  Sollzins -->
                    <RowDefinition Height="Auto"/> <!-- 5  Rate / Anzahl -->
                    <RowDefinition Height="Auto"/> <!-- 6  Erste Rate -->
                    <RowDefinition Height="Auto"/> <!-- 7  Wochenende/Feiertag -->
                    <RowDefinition Height="Auto"/> <!-- 8  Bezahlt über -->
                    <RowDefinition Height="Auto"/> <!-- 9  Auszahlung (nur Kredit) -->
                    <RowDefinition Height="Auto"/> <!-- 10 Notiz -->
                </Grid.RowDefinitions>

                <Grid.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="Margin" Value="0,0,10,12"/>
                        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                    </Style>
                    <Style x:Key="KeyLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                    </Style>
                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                        <Setter Property="Margin" Value="0,0,0,12"/>
                    </Style>
                    <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                        <Setter Property="Margin" Value="0,0,0,12"/>
                        <Setter Property="HorizontalAlignment" Value="Stretch"/>
                        <Setter Property="DisplayMemberPath" Value="Text"/>
                        <Setter Property="SelectedValuePath" Value="Value"/>
                    </Style>
                    <Style TargetType="DatePicker" BasedOn="{StaticResource {x:Type DatePicker}}">
                        <Setter Property="Margin" Value="0,0,0,12"/>
                    </Style>
                </Grid.Resources>

                <TextBlock Grid.Row="0" Text="Art"/>
                <ComboBox  Grid.Row="0" Grid.Column="1" x:Name="KindBox" SelectionChanged="Input_Changed"/>

                <TextBlock Grid.Row="1" Text="Bezeichnung"/>
                <TextBox   Grid.Row="1" Grid.Column="1" x:Name="NameBox" MaxLength="{x:Static m:Limits.MaxTextLength}"/>

                <TextBlock Grid.Row="2" x:Name="LenderLabel" Text="Bank"/>
                <TextBox   Grid.Row="2" Grid.Column="1" x:Name="LenderBox" MaxLength="{x:Static m:Limits.MaxTextLength}"/>

                <TextBlock Grid.Row="3" x:Name="AmountLabel" Style="{StaticResource KeyLabel}" Text="Kreditbetrag (€)"/>
                <TextBox   Grid.Row="3" Grid.Column="1" x:Name="AmountBox" FontWeight="SemiBold" TextChanged="Amount_Changed"/>

                <TextBlock Grid.Row="4" Text="Sollzins (% p. a.)"/>
                <TextBox   Grid.Row="4" Grid.Column="1" x:Name="InterestBox" TextChanged="Amount_Changed"
                           ToolTip="Gebundener Sollzins pro Jahr, z. B. 5,9. Bei zinsfreier Finanzierung 0 eintragen."/>

                <TextBlock Grid.Row="5" Style="{StaticResource KeyLabel}" Text="Monatliche Rate (€)"/>
                <DockPanel Grid.Row="5" Grid.Column="1" Margin="0,0,0,12">
                    <TextBox x:Name="CountBox" DockPanel.Dock="Right" Width="70" Margin="0" TextAlignment="Right"
                             TextChanged="Count_Changed"
                             ToolTip="Anzahl der Raten eintragen – die passende monatliche Rate wird berechnet."/>
                    <TextBlock DockPanel.Dock="Right" Text="oder Anzahl Raten" Margin="12,0,8,0"/>
                    <TextBox x:Name="RateBox" Margin="0" FontWeight="SemiBold" TextChanged="Rate_Changed"/>
                </DockPanel>

                <TextBlock  Grid.Row="6" Text="Erste Rate am"/>
                <DatePicker Grid.Row="6" Grid.Column="1" x:Name="FirstRatePicker" SelectedDateChanged="Date_Changed"
                            ToolTip="Alle weiteren Raten folgen monatlich am selben Tag (in kürzeren Monaten am Monatsende)."/>

                <TextBlock Grid.Row="7" Text="Wochenende/Feiertag"/>
                <ComboBox  Grid.Row="7" Grid.Column="1" x:Name="WeekendBox" SelectionChanged="Input_Changed"/>

                <TextBlock Grid.Row="8" Text="Bezahlt über"/>
                <ComboBox  Grid.Row="8" Grid.Column="1" x:Name="PaymentBox" DisplayMemberPath="" MaxDropDownHeight="320">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <local:PaymentIcon Method="{Binding Value}" Size="16" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding Text}" Margin="0" Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Grid.Row="9" x:Name="PayoutLabel" Text="Auszahlung aufs Konto"/>
                <DockPanel Grid.Row="9" Grid.Column="1" x:Name="PayoutPanel" Margin="0,0,0,12">
                    <CheckBox x:Name="HasPayoutBox" VerticalAlignment="Center" Margin="0,0,4,0" MinWidth="0"
                              Checked="Input_Changed" Unchecked="Input_Changed"
                              ToolTip="Den Kreditbetrag an diesem Tag als Einnahme aufs Konto buchen"/>
                    <DatePicker x:Name="PayoutPicker" Margin="0" IsEnabled="False" SelectedDateChanged="Date_Changed"/>
                </DockPanel>

                <TextBlock Grid.Row="10" Text="Notiz"/>
                <TextBox   Grid.Row="10" Grid.Column="1" x:Name="NoteBox" MaxLength="{x:Static m:Limits.MaxNoteLength}"/>
            </Grid>

            <!-- ======================================================== Zusammenfassung -->
            <Border Style="{StaticResource InfoBox}" Margin="0,2,0,6">
                <DockPanel>
                    <TextBlock Style="{StaticResource InfoGlyph}"/>
                    <TextBlock x:Name="SummaryText" Style="{StaticResource InfoText}"/>
                </DockPanel>
            </Border>
        </StackPanel>
    </DockPanel>
</Window>
