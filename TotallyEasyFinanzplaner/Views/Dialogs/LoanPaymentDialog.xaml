<!--
    Sondertilgung eintragen oder Kredit vorzeitig ablösen (Restschuld an einem Tag auf einmal zahlen).
    Prüfung und Vorschau des Ablösebetrags in LoanPaymentDialog.xaml.cs.
-->
<Window x:Class="TotallyEasyFinanzplaner.LoanPaymentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m="clr-namespace:TotallyEasyFinanzplaner.Models"
        Style="{StaticResource DialogWindow}" WindowStartupLocation="CenterOwner" Width="480">
    <DockPanel>
        <!-- ============================================================ Fußleiste -->
        <Border Style="{StaticResource DialogFooter}">
            <StackPanel Style="{StaticResource DialogButtons}">
                <Button Style="{StaticResource DialogButton}" Content="Abbrechen" IsCancel="True"/>
                <Button Style="{StaticResource DialogPrimaryButton}" Content="Speichern" IsDefault="True" Click="Ok_Click"/>
            </StackPanel>
        </Border>

        <StackPanel Style="{StaticResource DialogContent}">
            <DockPanel Style="{StaticResource DialogHeader}" Margin="0,0,0,18">
                <Border Style="{StaticResource DialogBadge}">
                    <TextBlock x:Name="HeaderGlyph" Style="{StaticResource DialogBadgeGlyph}" Text="&#xE710;"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderText" Style="{StaticResource DialogTitle}"/>
                    <TextBlock x:Name="SubText" Style="{StaticResource DialogSubtitle}"/>
                </StackPanel>
            </DockPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Datum -->
                    <RowDefinition Height="Auto"/> <!-- Betrag -->
                    <RowDefinition Height="Auto"/> <!-- Notiz (nur Sondertilgung) -->
                </Grid.RowDefinitions>
                <Grid.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="Margin" Value="0,0,10,12"/>
                        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                    </Style>
                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                        <Setter Property="Margin" Value="0,0,0,12"/>
                    </Style>
                    <Style TargetType="DatePicker" BasedOn="{StaticResource {x:Type DatePicker}}">
                        <Setter Property="Margin" Value="0,0,0,12"/>
                    </Style>
                </Grid.Resources>

                <TextBlock  Grid.Row="0" Text="Datum"/>
                <DatePicker Grid.Row="0" Grid.Column="1" x:Name="DatePicker" SelectedDateChanged="Date_Changed"/>

                <TextBlock Grid.Row="1" x:Name="AmountLabel" Text="Betrag (€)"/>
                <TextBox   Grid.Row="1" Grid.Column="1" x:Name="AmountBox" FontWeight="SemiBold" TextChanged="Amount_Changed"/>

                <TextBlock Grid.Row="2" x:Name="NoteLabel" Text="Notiz"/>
                <TextBox   Grid.Row="2" Grid.Column="1" x:Name="NoteBox" MaxLength="{x:Static m:Limits.MaxTextLength}"/>
            </Grid>

            <Border Style="{StaticResource InfoBox}" Margin="0,2,0,6">
                <DockPanel>
                    <TextBlock Style="{StaticResource InfoGlyph}"/>
                    <TextBlock x:Name="HintText" Style="{StaticResource InfoText}"/>
                </DockPanel>
            </Border>
        </StackPanel>
    </DockPanel>
</Window>
