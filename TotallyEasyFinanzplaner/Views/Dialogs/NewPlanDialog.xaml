<!-- Neuen, leeren Finanzplan anlegen – optional gleich verschlüsselt -->
<Window x:Class="TotallyEasyFinanzplaner.NewPlanDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TotallyEasyFinanzplaner"
        Style="{StaticResource DialogWindow}" WindowStartupLocation="CenterOwner" Title="Neuer Finanzplan" Width="520">
    <DockPanel>
        <!-- ============================================================ Fußleiste -->
        <Border Style="{StaticResource DialogFooter}">
            <StackPanel Style="{StaticResource DialogButtons}">
                <Button Style="{StaticResource DialogButton}" Content="Abbrechen" IsCancel="True"/>
                <Button x:Name="OkButton" Style="{StaticResource DialogPrimaryButton}" Content="Anlegen" IsDefault="True"
                        Click="Ok_Click"/>
            </StackPanel>
        </Border>

        <StackPanel Style="{StaticResource DialogContent}">
            <!-- ======================================================== Kopf -->
            <DockPanel Style="{StaticResource DialogHeader}">
                <Border Style="{StaticResource DialogBadge}">
                    <TextBlock Style="{StaticResource DialogBadgeGlyph}" Text="&#xE8A5;"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource DialogTitle}" Text="Neuer Finanzplan"/>
                    <TextBlock Style="{StaticResource DialogSubtitle}"
                               Text="Ein leerer Plan mit eigenem Startsaldo, eigenen Buchungen und Kategorien."/>
                </StackPanel>
            </DockPanel>

            <!-- ======================================================== Name und Ort -->
            <TextBlock Style="{StaticResource FieldLabel}" Text="Name"/>
            <TextBox x:Name="NameBox" TextChanged="NameBox_TextChanged"/>

            <TextBlock Style="{StaticResource FieldLabel}" Text="Speicherort" Margin="0,14,0,6"/>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Ändern…" Margin="8,0,0,0" Click="Browse_Click"/>
                <TextBox x:Name="FolderBox" IsReadOnly="True" Foreground="{DynamicResource MutedBrush}"/>
            </DockPanel>
            <!-- Vollständiger Dateiname, wird beim Tippen aktualisiert -->
            <TextBlock x:Name="FileText" Style="{StaticResource HintText}" TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/>

            <!-- ======================================================== Verschlüsselung -->
            <Border Style="{StaticResource OutlineBox}" Padding="14,12" Margin="0,18,0,0">
                <StackPanel>
                    <CheckBox x:Name="EncryptBox" Checked="EncryptBox_Changed" Unchecked="EncryptBox_Changed">
                        <StackPanel>
                            <TextBlock Text="Mit Passwort verschlüsseln" FontWeight="SemiBold"/>
                            <TextBlock Style="{StaticResource HintText}"
                                       Text="AES-256 – ohne Passwort ist der Inhalt nicht lesbar."/>
                        </StackPanel>
                    </CheckBox>

                    <StackPanel x:Name="PasswordPanel" Visibility="Collapsed" Margin="0,14,0,0">
                        <local:NewPasswordFields x:Name="NewFields"/>
                        <DockPanel Margin="0,12,0,0">
                            <TextBlock Style="{StaticResource WarningGlyph}" DockPanel.Dock="Left"
                                       VerticalAlignment="Top" Margin="0,2,8,0"/>
                            <TextBlock Style="{StaticResource HintText}"
                                       Text="Ein vergessenes Passwort kann nicht wiederhergestellt werden."/>
                        </DockPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorText}"/>
        </StackPanel>
    </DockPanel>
</Window>
