<!--
    Buchung anlegen oder bearbeiten.
    Welche Zeilen sichtbar sind (Job, Kategorie, Zahlungsweg, Abbuchungstag, Enddatum …), steuert EntryDialog.xaml.cs je nach Art und Rhythmus.
-->
<Window x:Class="TotallyEasyFinanzplaner.EntryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TotallyEasyFinanzplaner"
        xmlns:m="clr-namespace:TotallyEasyFinanzplaner.Models"
        Style="{StaticResource DialogWindow}" WindowStartupLocation="CenterOwner" Title="Eintrag" Width="500">
    <DockPanel>
        <!-- ============================================================ Fußleiste -->
        <Border Style="{StaticResource DialogFooter}">
            <StackPanel Style="{StaticResource DialogButtons}">
                <Button Style="{StaticResource DialogButton}" Content="Abbrechen" IsCancel="True"/>
                <Button Style="{StaticResource DialogPrimaryButton}" Content="Speichern" IsDefault="True" Click="Ok_Click"/>
            </StackPanel>
        </Border>

        <StackPanel Style="{StaticResource DialogContent}">
            <!-- ======================================================== Kopf -->
            <DockPanel Style="{StaticResource DialogHeader}" Margin="0,0,0,18">
                <Border Style="{StaticResource DialogBadge}">
                    <TextBlock Style="{StaticResource DialogBadgeGlyph}" Text="&#xE70F;"/>
                </Border>
                <TextBlock x:Name="HeaderText" Style="{StaticResource DialogTitle}" VerticalAlignment="Center"/>
            </DockPanel>

            <!-- ======================================================== Formular -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- 0  Bezeichnung -->
                    <RowDefinition Height="Auto"/> <!-- 1  Art -->
                    <RowDefinition Height="Auto"/> <!-- 2  Job (nur Gehalt) -->
                    <RowDefinition Height="Auto"/> <!-- 3  Kategorie (nur Ausgabe) -->
                    <RowDefinition Height="Auto"/> <!-- 4  Betrag -->
                    <RowDefinition Height="Auto"/> <!-- 5  Bezahlt über (nicht bei Gehalt) -->
                    <RowDefinition Height="Auto"/> <!-- 6  Rhythmus -->
                    <RowDefinition Height="Auto"/> <!-- 7  Buchungsmonate (nur vierteljährlich/halbjährlich/jährlich) -->
                    <RowDefinition Height="Auto"/> <!-- 8  Abbuchungstag -->
                    <RowDefinition Height="Auto"/> <!-- 9  Datum -->
                    <RowDefinition Height="Auto"/> <!-- 10 Endet am -->
                    <RowDefinition Height="Auto"/> <!-- 11 Wochenende/Feiertag -->
                    <RowDefinition Height="Auto"/> <!-- 12 Notiz -->
                </Grid.RowDefinitions>

                <!-- Beschriftung links, Feld rechts; 12 px Abstand zwischen den Zeilen -->
                <Grid.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="Margin" Value="0,0,10,12"/>
                        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                    </Style>
                    <!-- Hervorgehobene Beschriftung (Pflichtangabe der jeweiligen Art) -->
                    <Style x:Key="KeyLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                    </Style>
                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                        <Setter Property="Margin" Value="0,0,0,12"/>
                    </Style>
                    <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                        <Setter Property="Margin" Value="0,0,0,12"/>
                        <Setter Property="HorizontalAlignment" Value="Stretch"/>
                        <Setter Property="DisplayMemberPath" Value="Text"/>
                        <Setter Property="SelectedValuePath" Value="Value"/>
                    </Style>
                    <!-- Freitext-Auswahl mit einfachen Strings statt Text/Value-Paaren -->
                    <Style x:Key="EditableCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                        <Setter Property="IsEditable" Value="True"/>
                        <Setter Property="DisplayMemberPath" Value=""/>
                        <Setter Property="SelectedValuePath" Value=""/>
                    </Style>
                    <Style TargetType="DatePicker" BasedOn="{StaticResource {x:Type DatePicker}}">
                        <Setter Property="Margin" Value="0,0,0,12"/>
                    </Style>
                </Grid.Resources>

                <TextBlock Grid.Row="0" Text="Bezeichnung"/>
                <TextBox   Grid.Row="0" Grid.Column="1" x:Name="NameBox" MaxLength="{x:Static m:Limits.MaxTextLength}"/>

                <TextBlock Grid.Row="1" x:Name="TypeLabel" Text="Art"/>
                <ComboBox  Grid.Row="1" Grid.Column="1" x:Name="TypeBox" SelectionChanged="TypeBox_SelectionChanged"/>

                <TextBlock Grid.Row="2" x:Name="JobLabel" Style="{StaticResource KeyLabel}" Text="Arbeitgeber / Job"/>
                <ComboBox  Grid.Row="2" Grid.Column="1" x:Name="JobBox" Style="{StaticResource EditableCombo}"
                           ToolTip="Name des Arbeitgebers bzw. Jobs – Gehälter werden danach gruppiert"/>

                <TextBlock Grid.Row="3" x:Name="CategoryLabel" Text="Kategorie"/>
                <ComboBox  Grid.Row="3" Grid.Column="1" x:Name="CategoryBox" Style="{StaticResource EditableCombo}"
                           MaxDropDownHeight="340"
                           ToolTip="Kategorie auswählen oder einen neuen Namen eintippen – neue Kategorien werden automatisch gespeichert. Verwalten unter Buchungen › Kategorien."/>

                <TextBlock Grid.Row="4" Text="Betrag (€)"/>
                <TextBox   Grid.Row="4" Grid.Column="1" x:Name="AmountBox" FontWeight="SemiBold"/>

                <TextBlock Grid.Row="5" x:Name="PaymentLabel" Text="Bezahlt über"/>
                <ComboBox  Grid.Row="5" Grid.Column="1" x:Name="PaymentBox" DisplayMemberPath="" MaxDropDownHeight="320"
                           ToolTip="Worüber gekauft bzw. bezahlt wurde (z. B. PayPal in 30 Tagen, Klarna, Kreditkartenabrechnung). Abgebucht wird trotzdem vom Konto – die Angabe dient nur der Übersicht.">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <local:PaymentIcon Method="{Binding Value}" Size="16" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding Text}" Margin="0" Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Grid.Row="6" x:Name="RecurrenceLabel" Text="Rhythmus"/>
                <ComboBox  Grid.Row="6" Grid.Column="1" x:Name="RecurrenceBox" SelectionChanged="RecurrenceBox_SelectionChanged"/>

                <TextBlock Grid.Row="7" x:Name="MonthLabel" Style="{StaticResource KeyLabel}" Text="Buchungsmonate"/>
                <ComboBox  Grid.Row="7" Grid.Column="1" x:Name="MonthBox" MaxDropDownHeight="320"
                           ToolTip="In welchen Monaten gebucht wird – z. B. vierteljährlich Feb · Mai · Aug · Nov"
                           SelectionChanged="MonthBox_SelectionChanged"/>

                <TextBlock Grid.Row="8" x:Name="DayLabel" Style="{StaticResource KeyLabel}" Text="Abbuchungstag"/>
                <ComboBox  Grid.Row="8" Grid.Column="1" x:Name="DayBox" MaxDropDownHeight="320"
                           SelectionChanged="DayBox_SelectionChanged"/>

                <TextBlock  Grid.Row="9" x:Name="DateLabel" Text="Datum"/>
                <DatePicker Grid.Row="9" Grid.Column="1" x:Name="StartPicker" SelectedDateChanged="StartPicker_SelectedDateChanged"/>

                <TextBlock Grid.Row="10" x:Name="EndLabel" Text="Endet am"/>
                <DockPanel Grid.Row="10" Grid.Column="1" x:Name="EndPanel" Margin="0,0,0,12">
                    <CheckBox x:Name="HasEndBox" VerticalAlignment="Center" Margin="0,0,4,0" MinWidth="0"
                              Checked="HasEndBox_Changed" Unchecked="HasEndBox_Changed"/>
                    <DatePicker x:Name="EndPicker" Margin="0" IsEnabled="False"/>
                </DockPanel>

                <TextBlock Grid.Row="11" Text="Wochenende/Feiertag"/>
                <ComboBox  Grid.Row="11" Grid.Column="1" x:Name="WeekendBox" SelectionChanged="WeekendBox_SelectionChanged"
                           ToolTip="An Samstagen, Sonntagen und Feiertagen wird nicht gebucht – die Buchung erfolgt am nächsten bzw. vorherigen Werktag."/>

                <TextBlock Grid.Row="12" Text="Notiz"/>
                <TextBox   Grid.Row="12" Grid.Column="1" x:Name="NoteBox" MaxLength="{x:Static m:Limits.MaxNoteLength}"/>
            </Grid>

            <!-- ======================================================== Hinweise -->
            <!-- Erklärt den gewählten Rhythmus -->
            <Border Style="{StaticResource InfoBox}" Margin="0,2,0,10">
                <DockPanel>
                    <TextBlock Style="{StaticResource InfoGlyph}"/>
                    <TextBlock x:Name="HintText" Style="{StaticResource InfoText}"/>
                </DockPanel>
            </Border>

            <!-- Ausgesetzte Termine der Serie -->
            <Border x:Name="SkippedPanel" Style="{StaticResource InfoBox}" Background="{DynamicResource OneTimeSoftBrush}"
                    Padding="12,8" Margin="0,0,0,8" Visibility="Collapsed">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Wiederherstellen" Margin="10,0,0,0" Click="RestoreSkipped_Click"/>
                    <TextBlock x:Name="SkippedText" Style="{StaticResource InfoText}" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>
        </StackPanel>
    </DockPanel>
</Window>
