<!-- Kategorien verwalten: anlegen, umbenennen (auch zusammenführen) und löschen; Änderungen werden sofort gespeichert -->
<Window x:Class="TotallyEasyFinanzplaner.CategoryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TotallyEasyFinanzplaner"
        Style="{StaticResource DialogWindow}" WindowStartupLocation="CenterOwner" Title="Kategorien verwalten"
        SizeToContent="Manual" Width="560" Height="640" MinHeight="420" ResizeMode="CanResize">
    <DockPanel>
        <!-- ============================================================ Fußleiste -->
        <Border Style="{StaticResource DialogFooter}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource DialogButton}" Content="Schließen"
                        IsCancel="True" IsDefault="True" Margin="0" MinWidth="110" Click="Close_Click"/>
                <TextBlock Style="{StaticResource HintText}" FontSize="12" VerticalAlignment="Center"
                           Text="Änderungen werden sofort übernommen."/>
            </DockPanel>
        </Border>

        <DockPanel Style="{StaticResource DialogContent}">
            <!-- ======================================================== Kopf -->
            <DockPanel Style="{StaticResource DialogHeader}">
                <Border Style="{StaticResource DialogBadge}">
                    <TextBlock Style="{StaticResource DialogBadgeGlyph}" Text="&#xE8EC;"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource DialogTitle}" Text="Kategorien verwalten"/>
                    <TextBlock Style="{StaticResource DialogSubtitle}" FontSize="12"
                               Text="Standardkategorien stehen immer zur Auswahl. Eigene Kategorien kannst du anlegen, umbenennen (auch in eine bestehende, um zwei zusammenzuführen) und löschen."/>
                </StackPanel>
            </DockPanel>

            <!-- ======================================================== Aktionen -->
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <Button Style="{StaticResource PrimaryIconButton}" local:Ui.Icon="&#xE710;" Content="Neue Kategorie"
                        Click="Add_Click"/>
                <Button x:Name="RenameButton" Style="{StaticResource IconButton}" local:Ui.Icon="&#xE8AC;" Content="Umbenennen"
                        IsEnabled="False" Click="Rename_Click"/>
                <Button x:Name="DeleteButton" Style="{StaticResource IconButton}" local:Ui.Icon="&#xE74D;" Content="Löschen"
                        IsEnabled="False" Click="Delete_Click"/>
            </WrapPanel>

            <!-- ======================================================== Liste -->
            <Border Style="{StaticResource OutlineBox}">
                <ListBox x:Name="CategoryList" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch"
                         SelectionChanged="CategoryList_SelectionChanged" MouseDoubleClick="Rename_Click">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="2,6">
                                <!-- Rechts: Betrag pro Monat und Anzahl Buchungen -->
                                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <TextBlock Text="{Binding MonthlyText}" FontWeight="SemiBold" HorizontalAlignment="Right"
                                               Foreground="{DynamicResource ExpenseBrush}"/>
                                    <TextBlock Text="{Binding CountText}" Style="{StaticResource MutedText}" HorizontalAlignment="Right"/>
                                </StackPanel>
                                <!-- Links: Schloss (Standard) bzw. Etikett (eigene Kategorie) -->
                                <TextBlock x:Name="Icon" DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE72E;" FontSize="12"
                                           Width="18" Margin="0,0,10,0" Foreground="{DynamicResource MutedBrush}"
                                           ToolTip="Standardkategorie"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="Kind" Style="{StaticResource MutedText}" Text="Standard"/>
                                </StackPanel>
                            </DockPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsCustom}" Value="True">
                                    <Setter TargetName="Icon" Property="Text" Value="&#xE8EC;"/>
                                    <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                    <Setter TargetName="Icon" Property="ToolTip" Value="Eigene Kategorie"/>
                                    <Setter TargetName="Kind" Property="Text" Value="Eigene Kategorie"/>
                                    <Setter TargetName="Kind" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </DockPanel>
    </DockPanel>
</Window>
