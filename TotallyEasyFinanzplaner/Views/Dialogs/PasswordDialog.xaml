<!--
    Passwort-Dialog für Entsperren, Festlegen, Ändern und Entfernen.
    Welche Bereiche sichtbar sind und welche Texte erscheinen, legen die Fabrikmethoden in PasswordDialog.xaml.cs fest.
-->
<Window x:Class="TotallyEasyFinanzplaner.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TotallyEasyFinanzplaner"
        Style="{StaticResource DialogWindow}" WindowStartupLocation="CenterOwner" Width="470">
    <DockPanel>
        <!-- ============================================================ Fußleiste -->
        <Border Style="{StaticResource DialogFooter}">
            <DockPanel>
                <StackPanel Style="{StaticResource DialogButtons}">
                    <Button x:Name="CancelButton" Style="{StaticResource DialogButton}" Content="Abbrechen" IsCancel="True"/>
                    <Button x:Name="OkButton" Style="{StaticResource DialogPrimaryButton}" Content="OK" IsDefault="True"
                            Click="Ok_Click"/>
                </StackPanel>
                <!-- Nur beim Entsperren -->
                <Button x:Name="OtherButton" Style="{StaticResource LinkButton}" local:Ui.Icon="&#xE838;"
                        Content="Anderen Plan öffnen…" HorizontalAlignment="Left" Visibility="Collapsed"
                        Click="Other_Click"/>
            </DockPanel>
        </Border>

        <StackPanel Style="{StaticResource DialogContent}">
            <!-- ======================================================== Kopf -->
            <DockPanel Style="{StaticResource DialogHeader}">
                <Border Style="{StaticResource DialogBadge}">
                    <TextBlock x:Name="HeaderIcon" Style="{StaticResource DialogBadgeGlyph}" Text="&#xE72E;"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderText" Style="{StaticResource DialogTitle}"/>
                    <TextBlock x:Name="SubText" Style="{StaticResource DialogSubtitle}"/>
                </StackPanel>
            </DockPanel>

            <!-- ======================================================== Aktuelles Passwort -->
            <!-- Entsperren / Ändern / Entfernen -->
            <StackPanel x:Name="CurrentPanel">
                <TextBlock x:Name="CurrentLabel" Style="{StaticResource FieldLabel}" Text="Passwort"/>
                <PasswordBox x:Name="CurrentBox" KeyUp="CurrentBox_KeyUp" GotFocus="CurrentBox_KeyUp"/>
                <StackPanel x:Name="CapsWarning" Orientation="Horizontal" Margin="0,8,0,0" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource WarningGlyph}"/>
                    <TextBlock Style="{StaticResource WarningText}" Text="Die Feststelltaste ist aktiv."/>
                </StackPanel>
            </StackPanel>

            <!-- ======================================================== Neues Passwort -->
            <!-- Festlegen / Ändern -->
            <local:NewPasswordFields x:Name="NewFields" Margin="0,14,0,0"/>

            <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorText}"/>

            <!-- ======================================================== Hinweis -->
            <Border x:Name="InfoBox" Style="{StaticResource InfoBox}" Margin="0,16,0,0">
                <DockPanel>
                    <TextBlock x:Name="InfoIcon" Style="{StaticResource InfoGlyph}"/>
                    <TextBlock x:Name="InfoText" Style="{StaticResource InfoText}"/>
                </DockPanel>
            </Border>
        </StackPanel>
    </DockPanel>
</Window>
